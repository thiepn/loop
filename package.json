{
  "name": "loop",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "cert:browser": "node scripts/phase16-browser-cert.mjs",
    "test:rc": "playwright test --config=playwright.config.mjs",
    "smoke:production": "node scripts/phase18-live-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@playwright/test": "1.63.0"
  }
}
